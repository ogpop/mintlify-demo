  "keyFeatures": [
    "Real-time odds and fixtures across all major sports",
    "Straight, parlay, teaser, and special bet placement",
    "Snapshot and delta polling for efficient odds updates",
    "Live (in-running) betting with live-delay handling",
    "Deduplication via uniqueRequestId to prevent duplicate bets",
    "Alternate lines and round-robin parlay support",
    "Per-sport rate limiting with clear 429 error responses",
    "HTTP Basic authentication over HTTPS"
  ],
